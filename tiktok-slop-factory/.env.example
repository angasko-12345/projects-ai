# Required. Copy this file to .env and fill in your key.
# Get a Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides.
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# TTS_VOICE=Kore
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# Absolute path to a bold TTF for the on-screen scene keywords.
# VISUAL_FONT=C:/Windows/Fonts/arialbd.ttf

# No stock-media API is required. Visuals are generated locally with FFmpeg.
