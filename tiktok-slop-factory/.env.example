# Copy this file to .env and fill in what you use. Every setting is optional
# except GEMINI_API_KEY, and that one is required by `--backend gemini` only.
# `--backend local` needs no key at all.

# --- Backend selection -------------------------------------------------------
# Which text backend runs when --backend is not passed. One of:
#   gemini (default) | local
# TEXT_BACKEND=local

# --- gemini backend ----------------------------------------------------------
# Required for `--backend gemini`. Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# TTS_VOICE=Kore

# --- local backend -----------------------------------------------------------
# Text file with a "scripts" array. Defaults to <project root>/local_text.json.
# TEXT_PROVIDER_JSON=local_text.json
# Edge TTS voice and rate. Separate from TTS_VOICE because the two backends
# name their voices differently.
# EDGE_TTS_VOICE=en-GB-SoniaNeural
# EDGE_TTS_RATE=+8%

# --- Shared / tools ----------------------------------------------------------
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# Absolute path to a bold TTF for the on-screen scene keywords.
# VISUAL_FONT=C:/Windows/Fonts/arialbd.ttf

# No stock-media API is required. Visuals are generated locally with FFmpeg.
