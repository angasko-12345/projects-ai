# Python
__pycache__/
*.py[cod]
*.egg-info/
# Virtual environments
.venv/
venv/
# Checkpoints / experiment output (kept as empty dirs via .gitkeep); ** also covers nested run dirs
checkpoints/**/*.pt
checkpoints/**/*.zip
checkpoints/**/*.pkl
experiments/*/
!experiments/.gitkeep
# Cross-game generalization evidence is tracked (plan, results, metrics, small GIFs);
# checkpoints never are -- they live outside the repo (see experiments/generalization/RESULTS.md).
!experiments/generalization/
experiments/generalization/**/*.pt
experiments/generalization/**/*.zip
# Stage 1 (ALE) evidence is tracked the same way; checkpoints never are.
!experiments/stage1/
experiments/stage1/**/*.pt
experiments/stage1/**/*.zip
# Stage 2 (benchmark readiness) evidence: plan, results, small JSON, Kaggle kit; never checkpoints.
!experiments/stage2/
experiments/stage2/**/*.pt
experiments/stage2/**/*.zip
logs/*.log
# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
