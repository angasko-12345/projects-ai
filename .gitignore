# Container-level ignores.
#
# Every ignore rule lives here instead of .git/info/exclude so that fresh
# clones are protected too. See .agents/memory/decisions.md for the decision
# that superseded the prior root .gitignore removal.
#
# Subproject .gitignore files (agentops/, universal-game-agent/) own
# product-specific patterns such as __pycache__, .venv, checkpoints/**/*.pt,
# logs/*.log, and experiments/*/. This file covers the container root only.

.misc/
.playwright-mcp/
.playwright_mcp/
agent-intercom-fix/
.agentops/
.local-temp-archive/
.pi/
orchestrator.py
omniroute-model-results.csv
working_models.txt

# Common
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Secrets. A root-level `.env` was committed and then deleted early in this
# repository's history (2a72f2d -> 037d8bd), so keep it out for good. Keep the
# tracked `*.example` templates committable.
.env
.env.*
!.env.example
build/
dist/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Build / signing artifacts. Binaries ship as GitHub Release assets, never as
# commits (see tasks/after-task.md section 3). qr-generator/.gitignore carries
# the in-product copy of these patterns; these cover the container root.
*.apk
*.aab

# Third-party agent tool config, self-managed via its own internal .gitignore.
.kilo/

# Local scratch probes at the repo root. Real tests live inside each product's
# tests/ directory and run with `python -m unittest discover -s tests`.
/debug_test.py
/task.py
/test_cli.py
/test_task.py
/test_output.txt
/test_output_full.txt
